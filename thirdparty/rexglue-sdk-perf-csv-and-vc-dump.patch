+// Resolve the perf_log_csv cvar (once) and open the CSV log if it is set.
+// `perf_log_csv` and the CSV writer were exported but never wired: nothing read the cvar, so
+// REX_PERF_LOG_CSV=<path> wrote no file. Startup calls this after the cvar config and environment
+// have been applied; repeated calls are no-ops so a second call cannot truncate the log.
+void StartCsvLogFromCvar() {
+  static bool resolved = false;
+  if (resolved)
+    return;
+  resolved = true;
+
+  std::string path = REXCVAR_GET(perf_log_csv);
+  if (path.empty())
+    return;
+
+  SetCsvLogPath(path);
+  if (g_csv_file)
+    REXLOG_INFO("perf: CSV frame log -> {}", path);
+}
