+// ---------------------------------------------------------------------------
+// Fable2 vertex-constant dump probe — env-gated, read-only, inert unless
+// FABLE2_VC_DUMP is set. Called from both register-write paths, because the game
+// reaches the vertex constant block through BOTH of them (bulk range packets and
+// single-register writes).
+//   FABLE2_VC_DUMP=<path>[;<path>...]  append 256xfloat4 snapshots, first writable wins
+//   FABLE2_VC_DUMP_EVERY=<n>           sample every n-th frame (default 60)
+//   FABLE2_VC_DUMP_PER_FRAME=<n>       cap snapshots per sampled frame (default 40)
+//   FABLE2_VC_DUMP_LO/_HI=<slot>       only snapshots when the written float4 slot
+//                                      falls inside [LO,HI] (default 0..255)
+// A block identical to the previously written one is skipped.
+// ---------------------------------------------------------------------------
+static void Fable2VcDumpProbe(const RegisterFile& rf, uint64_t frame_current,
+                              uint32_t first_reg, uint32_t last_reg) {
+  static const std::vector<std::string> vc_paths = [] {
+    std::vector<std::string> out;
+    const char* e = std::getenv("FABLE2_VC_DUMP");
+    if (e) {
+      std::string s(e);
+      size_t start = 0;
+      while (start <= s.size()) {
+        size_t sep = s.find(';', start);
+        std::string part =
+            s.substr(start, sep == std::string::npos ? std::string::npos : sep - start);
+        if (!part.empty()) {
+          out.push_back(part);
+        }
+        if (sep == std::string::npos) {
+          break;
+        }
+        start = sep + 1;
+      }
+    }
+    return out;
+  }();
+  static const int vc_every = [] {
+    const char* e = std::getenv("FABLE2_VC_DUMP_EVERY");
+    return e ? std::atoi(e) : 60;
+  }();
+  static const int vc_per_frame = [] {
+    const char* e = std::getenv("FABLE2_VC_DUMP_PER_FRAME");
+    return e ? std::atoi(e) : 40;
+  }();
+  static const int vc_lo = [] {
+    const char* e = std::getenv("FABLE2_VC_DUMP_LO");
+    return e ? std::atoi(e) : 0;
+  }();
+  static const int vc_hi = [] {
+    const char* e = std::getenv("FABLE2_VC_DUMP_HI");
+    return e ? std::atoi(e) : 255;
+  }();
+  static int vc_which = -1;
+  static bool vc_probed = false;
+  static uint32_t vc_last_hash = 0;
+  static bool vc_have_hash = false;
+  static uint64_t vc_last_frame = UINT64_MAX;
+  static int vc_frame_dumps = 0;
+  if (vc_paths.empty()) {
+    return;
+  }
+  if (!vc_probed) {
+    // proof the probe is in the loaded DLL and reached, whatever the path does
+    vc_probed = true;
+    if (FILE* m = std::fopen("vc-probe-alive.txt", "a")) {
+      std::fprintf(m, "vc-probe alive: %zu candidate path(s)\n", vc_paths.size());
+      std::fclose(m);
+    }
+  }
+  if (vc_which < 0) {
+    for (size_t i = 0; i < vc_paths.size(); ++i) {
+      if (FILE* t = std::fopen(vc_paths[i].c_str(), "a")) {
+        std::fclose(t);
+        vc_which = static_cast<int>(i);
+        break;
+      }
+    }
+  }
+  if (vc_which < 0) {
+    return;
+  }
+  int32_t first_slot = static_cast<int32_t>((first_reg - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2);
+  int32_t last_slot = static_cast<int32_t>((last_reg - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2);
+  if (last_slot < vc_lo || first_slot > vc_hi) {
+    return;
+  }
+  uint64_t interval = vc_every > 0 ? static_cast<uint64_t>(vc_every) : 60;
+  if (frame_current % interval != 0) {
+    return;
+  }
+  if (frame_current != vc_last_frame) {
+    vc_last_frame = frame_current;
+    vc_frame_dumps = 0;
+  }
+  if (vc_frame_dumps >= (vc_per_frame > 0 ? vc_per_frame : 40)) {
+    return;
+  }
+  const uint32_t* blk = rf.values + XE_GPU_REG_SHADER_CONSTANT_000_X;
+  uint32_t h = 2166136261u;
+  for (uint32_t i = 0; i < 1024; ++i) {
+    h = (h ^ blk[i]) * 16777619u;
+  }
+  if (vc_have_hash && h == vc_last_hash) {
+    return;  // unchanged block: nothing to record
+  }
+  vc_last_hash = h;
+  vc_have_hash = true;
+  ++vc_frame_dumps;
+  FILE* f = std::fopen(vc_paths[static_cast<size_t>(vc_which)].c_str(), "a");
+  if (!f) {
+    return;
+  }
+  std::fprintf(f, "VC frame=%llu start_reg=%u n=%u dump_in_frame=%d\n",
+               static_cast<unsigned long long>(frame_current), first_reg,
+               last_reg - first_reg + 1, vc_frame_dumps);
+  for (uint32_t i = 0; i < 256; ++i) {
+    float v[4];
+    std::memcpy(v, &rf.values[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * i], 16);
+    std::fprintf(f, "  vc[%3u] % .7g % .7g % .7g % .7g\n", i, v[0], v[1], v[2], v[3]);
+  }
+  std::fclose(f);
+}
