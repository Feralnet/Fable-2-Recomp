+    # The filtered table is generated at CONFIGURE time, so without this an edit
+    # to src/system/rexruntime.def would be silently ignored by a D3D12-only
+    # build (the linker keeps using the stale generated copy, and a newly
+    # exported function only shows up as an undefined symbol at link time).
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+        "${CMAKE_CURRENT_SOURCE_DIR}/rexruntime.def")
