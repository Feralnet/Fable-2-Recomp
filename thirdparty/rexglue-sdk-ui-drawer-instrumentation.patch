@@ -1283,9 +1357,92 @@ void Presenter::ExecuteUIDrawersFromUIThread(UIDrawContext& ui_draw_context) {
   // Drawers can add or remove drawers (including themselves), need to ensure
   // iterator validity in this case.
   assert_false(is_executing_ui_drawers_);
+  const bool ui_draw_detect = UiDrawersDetectEnabled();
+  if (UiDrawersFixEnabled()) {
+    // Fix shape: no iterator is held across Draw().  The next drawer is
+    // re-derived from the live map at every step, so a drawer that adds or
+    // removes entries (including itself) while it runs cannot leave this loop
+    // dereferencing an erased node.  The Z floor keeps the original
+    // "only ever move forward" behaviour; nothing already drawn this frame is
+    // drawn twice.
+    is_executing_ui_drawers_ = true;
+    for (;;) {
+      ui_draw_next_iterator_ = ui_drawers_.end();
+      std::multimap<size_t, UIDrawerReference>::iterator it_next = ui_drawers_.end();
+      for (auto it_candidate = ui_drawers_.begin(); it_candidate != ui_drawers_.end(); ++it_candidate) {
+        if (it_candidate->second.last_draw == ui_draw_current_) {
+          continue;
+        }
+        if (it_candidate->first < ui_draw_current_z_order_) {
+          continue;
+        }
+        it_next = it_candidate;
+        break;
+      }
+      if (it_next == ui_drawers_.end()) {
+        break;
+      }
+      const size_t ui_draw_z_order = it_next->first;
+      UIDrawer* const ui_draw_drawer = it_next->second.drawer;
+      ui_draw_current_z_order_ = ui_draw_z_order;
+      it_next->second.last_draw = ui_draw_current_;
+      if (ui_draw_detect) {
+        UiDrawersDetectf("walk-fix draw: z=%zu drawer=%p ui_draw_current=%zu", ui_draw_z_order,
+                         static_cast<void*>(ui_draw_drawer), ui_draw_current_);
+      }
+      ui_draw_drawer->Draw(ui_draw_context);
+    }
+    is_executing_ui_drawers_ = false;
+    ++ui_draw_current_;
+    return;
+  }
+  static uint64_t ui_draw_walk_index = 0;
+  const uint64_t ui_draw_walk = ui_draw_walk_index++;
+  if (ui_draw_detect) {
+    UiDrawersDetectf("walk %llu enter: %zu drawer(s), ui_draw_current=%zu", ui_draw_walk,
+                     ui_drawers_.size(), ui_draw_current_);
+  }
   ui_draw_next_iterator_ = ui_drawers_.begin();
   is_executing_ui_drawers_ = true;
   while (ui_draw_next_iterator_ != ui_drawers_.end()) {
+    // kanban t_683bb4e2: the iterator we are about to advance from must still
+    // name a node of the live tree - a drawer may have erased it during the
+    // Draw() call of the previous iteration.  Detect that before the walk
+    // dereferences the node instead of after the access violation.
+    if (ui_draw_detect) {
+      const void* ui_draw_node = static_cast<const void*>(&(*ui_draw_next_iterator_));
+      size_t ui_draw_live_count = 0;
+      bool ui_draw_node_is_live = false;
+      for (auto it_live = ui_drawers_.begin(); it_live != ui_drawers_.end(); ++it_live) {
+        ++ui_draw_live_count;
+        if (static_cast<const void*>(&(*it_live)) == ui_draw_node) {
+          ui_draw_node_is_live = true;
+          break;
+        }
+      }
+      if (!ui_draw_node_is_live) {
+        UiDrawersDetectf(
+            "DEAD ITERATOR walk %llu: next node %p is not among the %zu live node(s), "
+            "ui_draw_current=%zu ui_draw_current_z_order=%zu executing=%d",
+            ui_draw_walk, ui_draw_node, ui_draw_live_count, ui_draw_current_, ui_draw_current_z_order_,
+            is_executing_ui_drawers_ ? 1 : 0);
+        // Recover: continue with the first live node not yet drawn this frame.
+        bool ui_draw_resynced = false;
+        for (auto it_live = ui_drawers_.begin(); it_live != ui_drawers_.end(); ++it_live) {
+          if (it_live->second.last_draw != ui_draw_current_) {
+            ui_draw_next_iterator_ = it_live;
+            ui_draw_resynced = true;
+            break;
+          }
+        }
+        UiDrawersDetectf("DEAD ITERATOR walk %llu: recovery %s", ui_draw_walk,
+                         ui_draw_resynced ? "resynced to the next undrawn live node" : "terminating the walk");
+        if (!ui_draw_resynced) {
+          break;
+        }
+        continue;
+      }
+    }
     // The current iterator may be invalidated, and ui_draw_next_iterator_ may
     // be changed, during the execution of the drawer if the list of the drawers
