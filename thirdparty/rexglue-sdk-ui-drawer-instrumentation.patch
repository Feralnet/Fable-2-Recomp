+// ---------------------------------------------------------------------------
+// kanban t_683bb4e2 - ui_drawers_ iterator-invalidation detector.
+//
+// ExecuteUIDrawersFromUIThread holds ui_draw_next_iterator_ across a
+// caller-controlled UIDrawer::Draw() call, and the drawer is allowed to add or
+// remove drawers (including other ones, and itself) while it runs.  The erase
+// helpers advance the iterator when the node being erased *is* the next one,
+// which is correct for a single-threaded multimap, but nothing verifies it.
+//
+// With REX_UI_DRAWERS_DETECT pointing at a file, every walk iteration first
+// checks that the iterator still names a node that is live in ui_drawers_, logs
+// the exact interleaving when it does not, and recovers instead of walking the
+// freed node.  Without the variable the build is the ordinary one.
+// ---------------------------------------------------------------------------
+namespace {
+
+FILE* UiDrawersDetectFile() {
+  static FILE* file = []() -> FILE* {
+    const char* path = std::getenv("REX_UI_DRAWERS_DETECT");
+    if (!path || !*path) {
+      return nullptr;
+    }
+    return std::fopen(path, "a");
+  }();
+  return file;
+}
+
+bool UiDrawersDetectEnabled() { return UiDrawersDetectFile() != nullptr; }
+
+// Fix shape (kanban t_683bb4e2), off unless REX_UI_DRAWERS_FIX is set: instead
+// of holding an iterator into ui_drawers_ across the caller-controlled Draw()
+// call, re-derive the next drawer from the live map on every step, so nothing
+// this loop keeps can be erased underneath it.
+bool UiDrawersFixEnabled() {
+  const char* value = std::getenv("REX_UI_DRAWERS_FIX");
+  return value && *value && !(value[0] == '0' && value[1] == '\0');
+}
+
+void UiDrawersDetectf(const char* format, ...) {
+  FILE* file = UiDrawersDetectFile();
+  if (!file) {
+    return;
+  }
+  char buffer[512];
+  va_list args;
+  va_start(args, format);
+  std::vsnprintf(buffer, sizeof(buffer), format, args);
+  va_end(args);
+  std::fputs(buffer, file);
+  std::fputc('\n', file);
+  std::fflush(file);
+}
+
+}  // namespace
+
 REXCVAR_DEFINE_BOOL(host_present_from_non_ui_thread, true, "UI/Presenter",
                     "Allow presentation from non-UI thread");
 
