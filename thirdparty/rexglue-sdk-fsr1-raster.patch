+const char* D3D12Presenter::GuestOutputPaintEffectName(GuestOutputPaintEffect effect) {
+  switch (effect) {
+    case Presenter::GuestOutputPaintEffect::kBilinear:
+      return "bilinear";
+    case Presenter::GuestOutputPaintEffect::kBilinearDither:
+      return "bilinear-dither";
+#if defined(REX_HAS_FIDELITYFX_SDK)
+    case Presenter::GuestOutputPaintEffect::kCasSharpen:
+      return "cas-sharpen";
+    case Presenter::GuestOutputPaintEffect::kCasSharpenDither:
+      return "cas-sharpen-dither";
+    case Presenter::GuestOutputPaintEffect::kCasResample:
+      return "cas-resample";
+    case Presenter::GuestOutputPaintEffect::kCasResampleDither:
+      return "cas-resample-dither";
+    case Presenter::GuestOutputPaintEffect::kFsrEasu:
+      return "fsr-easu";
+    case Presenter::GuestOutputPaintEffect::kFsrRcas:
+      return "fsr-rcas";
+    case Presenter::GuestOutputPaintEffect::kFsrRcasDither:
+      return "fsr-rcas-dither";
+#endif
+    default:
+      return "effect";
+  }
+}
