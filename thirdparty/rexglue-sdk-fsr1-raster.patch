+// Decides whether the current paint should be dumped (present_dump_final) and
+// builds the output file name. Called once per paint; the paint index advances
+// on every call.
+bool PlanFinalDump(uint32_t width, uint32_t height, std::string* path_out) {
+  static bool resolved = false;
+  static std::string dump_dir;
+  static int32_t start_index = 60;
+  static int32_t max_count = 3;
+  static int32_t every = 0;
+  static int64_t paint_index = -1;
+  static int32_t dumped_count = 0;
+  if (!resolved) {
+    resolved = true;
+    dump_dir = REXCVAR_GET(present_dump_final);
+    start_index = REXCVAR_GET(present_dump_final_start);
+    max_count = REXCVAR_GET(present_dump_final_count);
+    every = REXCVAR_GET(present_dump_final_every);
+    if (!dump_dir.empty()) {
+      std::error_code mkdir_error;
+      std::filesystem::create_directories(dump_dir, mkdir_error);
+      REXLOG_INFO("present dump: writing post-effect frames to {} from paint {} (every {})",
+                  dump_dir, start_index, every);
+    }
+  }
+  ++paint_index;
+  if (dump_dir.empty() || dumped_count >= max_count || paint_index < int64_t(start_index)) {
+    return false;
+  }
+  if (every > 0 && (paint_index - int64_t(start_index)) % int64_t(every) != 0) {
+    return false;
+  }
+  ++dumped_count;
+  char name[256];
+  snprintf(name, sizeof(name), "present-final-%05lld-%ux%u-%s.ppm", (long long)paint_index, width,
+           height, g_last_guest_output_flow_description.c_str());
+  *path_out = (std::filesystem::path(dump_dir) / name).string();
+  return true;
+}
+
+// Writes a binary PPM (P6) from a mapped B8G8R8A8 readback buffer.
+void WriteFinalDumpPpm(const void* mapped, const D3D12_PLACED_SUBRESOURCE_FOOTPRINT& layout,
+                       UINT rows, uint32_t width, uint32_t height, const std::string& path) {
+  FILE* file = fopen(path.c_str(), "wb");
+  if (!file) {
+    REXLOG_ERROR("present dump: cannot open {}", path);
+    return;
+  }
+  fprintf(file, "P6\n%u %u\n255\n", width, height);
+  const uint8_t* base = static_cast<const uint8_t*>(mapped);
+  const uint32_t pixel_bytes = layout.Footprint.Format == DXGI_FORMAT_R8G8B8A8_UNORM ? 4 : 4;
+  for (uint32_t y = 0; y < height; ++y) {
+    if (y >= rows) {
+      break;
+    }
+    const uint8_t* row = base + size_t(y) * layout.Footprint.RowPitch;
+    for (uint32_t x = 0; x < width; ++x) {
+      const uint8_t* texel = row + size_t(x) * pixel_bytes;
+      uint8_t rgb[3];
+      if (layout.Footprint.Format == DXGI_FORMAT_R8G8B8A8_UNORM) {
+        rgb[0] = texel[0];
+        rgb[1] = texel[1];
+        rgb[2] = texel[2];
+      } else {
+        rgb[0] = texel[2];
+        rgb[1] = texel[1];
+        rgb[2] = texel[0];
+      }
+      fwrite(rgb, 1, 3, file);
+    }
+  }
+  fclose(file);
+}
